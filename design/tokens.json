{
  "version": 1,
  "source": "frontend/src/app.css",
  "chrome": {
    "--chrome-bg": "#0a0a0a",
    "--chrome-fg": "#fafafa",
    "--chrome-input-bg": "#171717",
    "--chrome-input-fg": "#fafafa",
    "--chrome-input-border": "#404040",
    "--chrome-muted": "#8a8a8a"
  },
  "ops": {
    "--ops-surface": "#ffffff",
    "--ops-surface-raised": "#f5f5f5",
    "--ops-border": "#e5e5e5",
    "--ops-text": "#262626",
    "--ops-text-muted": "#737373",
    "--ops-link": "#2563eb",
    "--black": "#0a0a0a",
    "--white": "#fafafa"
  },
  "accent": {
    "--accent": "#e63600",
    "--accent-bg": "#fef2f0"
  },
  "gray": {
    "--gray-50": "#fafafa",
    "--gray-100": "#f5f5f5",
    "--gray-200": "#e5e5e5",
    "--gray-300": "#d4d4d4",
    "--gray-400": "#8a8a8a",
    "--gray-500": "#737373",
    "--gray-600": "#525252",
    "--gray-700": "#404040",
    "--gray-800": "#262626",
    "--gray-900": "#171717"
  },
  "status": {
    "--info": "#2563eb",
    "--success": "#1b7a3d",
    "--warning": "#8a6d00",
    "--danger": "#c62828"
  },
  "statusBg": {
    "--info-bg": "#eff6ff",
    "--success-bg": "#f0fdf4",
    "--warning-bg": "#fefce8",
    "--danger-bg": "#fef2f2"
  },
  "statusDark": {
    "--status-created": "#4ade80",
    "--status-modified": "#fbbf24",
    "--status-deleted": "#f87171"
  },
  "spacing": {
    "--space-3xs": "0.125rem",
    "--space-2xs": "0.25rem",
    "--space-xs": "0.5rem",
    "--space-sm": "0.75rem",
    "--space-md": "1rem",
    "--space-lg": "1.5rem",
    "--space-xl": "2rem",
    "--space-2xl": "2.5rem"
  },
  "borders": {
    "--border-strong": "1px solid var(--black)",
    "--border-muted": "1px solid var(--gray-200)",
    "--border-soft": "1px solid var(--gray-300)",
    "--border-accent": "1px solid var(--accent)",
    "--border-selected": "4px solid var(--accent)"
  },
  "shape": {
    "--radius-none": "0",
    "--radius-sm": "4px",
    "--radius-round": "50%"
  },
  "breakpoints": {
    "--break-sm": "480px",
    "--break-md": "768px",
    "--break-drawer": "900px",
    "--break-lg": "1024px",
    "--break-xl": "1200px"
  },
  "nodes": {
    "--node-type-bg": "#f5f3ff",
    "--node-type-border": "#5b21b6",
    "--node-callable-bg": "#eff6ff",
    "--node-callable-border": "#1e40af",
    "--node-contract-bg": "#ecfdf5",
    "--node-contract-border": "#065f46",
    "--node-value-bg": "#fffbeb",
    "--node-value-border": "#92400e",
    "--node-container-bg": "#f8fafc",
    "--node-container-border": "#334155"
  },
  "typography": {
    "--font-sans": "'Space Grotesk', -apple-system, BlinkMacSystemFont, sans-serif",
    "--font-mono": "'Space Mono', monospace",
    "--text-micro": "0.6rem",
    "--text-xs": "0.65rem",
    "--text-sm": "0.7rem",
    "--text-md": "0.75rem",
    "--text-code": "0.85rem",
    "--text-body": "1rem",
    "--text-title": "1.25rem",
    "--tracking-tight": "-0.03em",
    "--tracking-wide": "0.05em",
    "--tracking-wider": "0.08em",
    "--tracking-widest": "0.1em",
    "--leading-tight": "1.05",
    "--leading-snug": "1.1",
    "--leading-normal": "1.5",
    "--leading-relaxed": "1.6",
    "--leading-loose": "1.7"
  },
  "desktop": {
    "fontFamily": "-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, PingFang SC, Microsoft YaHei, Noto Sans SC, sans-serif",
    "accentActive": "#c22e00"
  }
}
