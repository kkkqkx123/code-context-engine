# Environment file for cce-server (mode 0600).
# Secrets and path anchors live here; config files reference them via ${VAR}.
# Rendered once and never overwritten by install scripts.

# Configuration file path (optional; defaults to ./config.toml)
CCE_CONFIG=

# API keys
CCE_EMB_API_KEY_SILICONFLOW=
CCE_LLM_API_KEY_SILICONFLOW=
CCE_DB_QDRANT_API_KEY=

# Database path anchors
CCE_DB_SQLITE_PATH=
CCE_DB_QDRANT_URL=

# Logging
CCE_LOG_LEVEL=info
CCE_LOG_OUTPUT=stdout
CCE_LOG_FORMAT=pretty
CCE_LOG_FILE=
