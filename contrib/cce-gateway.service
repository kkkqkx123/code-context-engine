[Unit]
Description=CCE file supply gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cce-gateway --project-id ${CCE_PROJECT_ID} --path ${CCE_GATEWAY_PATH} --server ${CCE_SERVER_URL} --health-file /var/lib/cce-gateway/health.json
EnvironmentFile=-/etc/cce/gateway.env
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
